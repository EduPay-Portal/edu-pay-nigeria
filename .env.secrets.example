# Template for scripts/migration/05_set_secrets.sh
# Copy to .env.secrets (git-ignored) and fill in the real values.
# NEVER commit .env.secrets.

# Shared secret Wema uses to authenticate to our VAS endpoints.
# Reuse the current value to avoid changing anything on Wema's side.
WEMA_VAS_BEARER_TOKEN=

# "711" for the test environment; Wema issues the production prefix.
WEMA_ACCOUNT_PREFIX=711

# "test" or "production"
WEMA_ENV=test

# Vendor name returned in account lookup responses.
WEMA_VENDOR_NAME=

# Sandbox-only placeholder identity values used when a student has no BVN/NIN.
WEMA_FALLBACK_BVN=
WEMA_FALLBACK_NIN=

# Header value the scheduled jobs send to the retry/reconciliation workers.
# Generate a fresh one: openssl rand -hex 32
CRON_SECRET=
